---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header";
import ImpactProgressSection from "@/components/Impacto";
import { ElectrificacionImpact } from "@/data/content";
import Footer from "@/components/Footer";
import ProgramSolutions from "@/components/ProgramSolutions";
import { electrificacionSolutions } from "@/data/content";
---

<Layout title="Sedener">
    <Header variant="solid" currentPath={Astro.url.pathname} client:load />
    {
        ElectrificacionImpact.map((section) => (
            <ImpactProgressSection data={section} client:visible />
        ))
    }
    <ProgramSolutions
        eyebrow="Tecnología y características"
        title="Lo que hace posible este programa"
        description="Conoce las principales soluciones y características que se consideran para que cada intervención sea útil, segura y adecuada a las necesidades de las comunidades."
        solutions={electrificacionSolutions}
        accent="orange"
    />
    <Footer />
</Layout>
