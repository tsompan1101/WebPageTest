---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header";
import ImpactProgressSection from "@/components/Impacto";
import { EstufasImpact, estufasBenefits } from "@/data/content";
import ProgramSolutions from "@/components/ProgramSolutions2";
import Beneficios from "@/components/Beneficios";
import { estufasSolutions } from "@/data/content";
import Footer from "@/components/Footer";
---

<Layout title="Sedener">
    <Header variant="solid" currentPath={Astro.url.pathname} client:load />
    {EstufasImpact.map((section) => (
        <ImpactProgressSection data={section} client:visible />
    ))}
    <ProgramSolutions
        eyebrow=""
        title="Tecnología Apropiada para la cocina."
        description="Conoce las soluciones abarcadas para que cada intervención sea útil, segura y adecuada a las necesidades de las comunidades."
        solutions={estufasSolutions}
        accent="orange"
    />

    <Beneficios
        title={estufasBenefits.title}
        centerLabel={estufasBenefits.centerLabel}
        items={estufasBenefits.items}
    />
    <Footer />
</Layout>
