---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header";
import { panelEspecificaciones } from "@/data/content";
import ProgramSolutions from "@/components/ProgramSolutions";
import DonationSection from "@/components/donacion";
import Footer from "@/components/Footer";
---

<Layout title="Sedener">
    <Header variant="solid" currentPath={Astro.url.pathname} client:load />
    <ProgramSolutions
        eyebrow="Especificaciones"
        title="¿Qué tipo de paneles utilizamos?"
        description="Conoce las Paneles Fotovoltaicos y sus características."
        solutions={panelEspecificaciones}
        accent="orange"
    />
    <DonationSection client:visible />
    <Footer />
</Layout>
