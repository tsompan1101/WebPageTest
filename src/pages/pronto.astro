---
const title = "Se está construyendo";
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
    </head>

    <body>
        <main>
            <div class="construction">
                <div class="icon">🚧</div>
                <h1>{title}</h1>
                <p>Estamos trabajando en brindarle el mejor servicio.</p>
                <p>Vuelve pronto.</p>
            </div>
        </main>
    </body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(body) {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #0f172a;
        color: white;
    }

    main {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .construction {
        padding: 2rem;
    }

    .icon {
        font-size: 5rem;
        margin-bottom: 1rem;
    }

    h1 {
        font-size: 3rem;
        margin: 0 0 1rem;
    }

    p {
        color: #94a3b8;
        font-size: 1.1rem;
        margin: 0.5rem 0;
    }
</style>
